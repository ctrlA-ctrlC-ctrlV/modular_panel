# ============================================================================
# PRICING CALCULATOR BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your specific values
# IMPORTANT: Never commit .env file to version control
# ============================================================================

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------
# Environment mode: development, production, or test
NODE_ENV=development

# Port the backend API server will listen on
PORT=4000

# Host the backend API server will bind to (typically localhost or 0.0.0.0)
HOST=localhost

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# REQUIRED: PostgreSQL connection string
# Format: postgres://username:password@host:port/database?sslmode=require
#
# Examples:
# - Local development: postgres://app_user:your-password@localhost:5432/pricing_calculator
# - SSH tunnel: postgres://app_user:your-password@127.0.0.1:5432/pricing_calculator
# - Public with TLS: postgres://app_user:your-password@db.example.com:5432/pricing_calculator?sslmode=require
#
# TODO: REPLACE WITH YOUR DATABASE CONNECTION STRING
DATABASE_URL=postgres://app_user:your-password@localhost:5432/pricing_calculator

# OPTIONAL: Database CA certificate for SSL verification (PEM format)
# Only required if using SSL with strict certificate verification
# Format: Multi-line PEM certificate as a single string with \n for newlines
# Example: "-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----\n"
#
# TODO: ADD YOUR CA CERTIFICATE IF USING SSL (leave blank for development)
# DATABASE_CA_CERT=

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
# Log level: error, warn, info, or debug
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# CORS CONFIGURATION
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# For development, typically the frontend dev server
# For production, your actual frontend domain(s)
#
# Examples:
# - Development: http://localhost:5173
# - Production: https://your-frontend-domain.com
# - Multiple: https://app.example.com,https://admin.example.com
#
# TODO: UPDATE WITH YOUR FRONTEND URL(S)
ALLOWED_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------------------------------------
# OPTIONAL: JWT secret for token signing (if implementing JWT auth)
# Generate a secure random string (at least 32 characters)
# Example generation: openssl rand -base64 32
#
# TODO: GENERATE AND ADD YOUR JWT SECRET FOR PRODUCTION
# JWT_SECRET=

# Admin API key for admin-protected endpoints
# Default is only for development - MUST be changed in production
# Generate a secure random string for production use
#
# TODO: GENERATE AND SET A SECURE ADMIN API KEY FOR PRODUCTION
ADMIN_API_KEY=dev-admin-key-change-in-production

# ----------------------------------------------------------------------------
# RATE LIMITING CONFIGURATION
# ----------------------------------------------------------------------------
# Time window for rate limiting in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per time window per IP
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------------------------------
# FILE UPLOAD CONFIGURATION
# ----------------------------------------------------------------------------
# Maximum file upload size in megabytes
MAX_FILE_SIZE_MB=10

# ----------------------------------------------------------------------------
# QUOTE DOCUMENT CONFIGURATION
# ----------------------------------------------------------------------------
# OPTIONAL: URL to your company/brand logo for quote documents
# Should be a publicly accessible URL or base64 data URL
# Example: https://your-domain.com/logo.png
#
# TODO: ADD YOUR LOGO URL IF DESIRED (leave blank to use default)
# QUOTE_DOC_BRAND_LOGO_URL=

# ----------------------------------------------------------------------------
# OBSERVABILITY CONFIGURATION
# ----------------------------------------------------------------------------
# Enable OpenTelemetry distributed tracing (true/false)
ENABLE_TRACING=false

# Enable Prometheus metrics export (true/false)
ENABLE_METRICS=false

# Port for Prometheus metrics endpoint (if ENABLE_METRICS=true)
METRICS_PORT=9090

# ============================================================================
# QUICK START GUIDE
# ============================================================================
#
# 1. REQUIRED CHANGES:
#    - Set DATABASE_URL with your PostgreSQL connection details
#    - Change ADMIN_API_KEY to a secure value for production
#
# 2. RECOMMENDED CHANGES:
#    - Update ALLOWED_ORIGINS with your frontend URL
#    - Set NODE_ENV=production for production deployments
#    - Generate and set JWT_SECRET if using JWT authentication
#
# 3. OPTIONAL CHANGES:
#    - Adjust LOG_LEVEL based on your needs (debug for development)
#    - Configure QUOTE_DOC_BRAND_LOGO_URL for branded documents
#    - Enable ENABLE_TRACING and ENABLE_METRICS for observability
#    - Add DATABASE_CA_CERT for SSL certificate verification
#
# 4. VALIDATION:
#    - Run the backend: npm run dev
#    - Check health endpoint: curl http://localhost:4000/api/v1/health
#    - Verify logs show "Configuration loaded successfully"
#
# For detailed setup instructions, see:
# - specs/001-pricing-calculator/ops/digitalocean-setup.md
# - specs/001-pricing-calculator/quickstart.md
#
# ============================================================================
